# Local environment / large corpora (kept out of git, re-created by the
# harness utilities in Topology/).
.venv/
.cache/
__pycache__/
*.pyc

# 328 MB ETH-80 image tree lives in .cache/ETH-80-raw and is exposed through
# this symlink; the symlink itself is not tracked.
data/ETH-80-master/

# Generated graph caches / binary results (text results are kept).
Topology/cache/
*.pkl
*.npz
# ... except the Mission-27 place-record export, which is committed ON PURPOSE (25.7 MB, budget
# 40 MB): it is what makes a fresh sandbox ready in 0.4 s instead of rebuilding records for 1,824 s.
!data/placement_records_m27.npz
!data/placement_records_m28.npz
# ... and M30's, which adds the five graded shape columns (v29, 37.4 MB, budget 40 MB).
!data/placement_records_m30.npz
Topology/results/placement/_graphcache/

# M16: the candidate-level bank is 138 MB (GitHub refused it at the pre-receive
# hook).  The profile that the report quotes is committed; the raw rows are
# regenerated by `placement_m16_bank.py --keep-bank`.
Topology/results/placement/m16_bank_raw.json

# M21: the paired score matrices are binary intermediates; the JSON that quotes them is kept.
*.npy

# Mission 23 pair caches: working state for resumable stages, not evidence.  m23_t2_pairs.jsonl
# also contains the --limit 4 smoke rows (chance arithmetic differs on a 4-object gallery), so it
# is kept out of the tree rather than committed and misquoted.  The READ's rows and pairs ARE
# committed: they are the data behind m23_read.json.
Topology/results/placement/m23_t2_pairs.jsonl
Topology/results/placement/m23_fit_pairs.jsonl
Topology/results/placement/m23_dev_pairs.jsonl
